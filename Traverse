byte mac[] = { 0xDE, 0xAD, 0xBE, 0xEF, 0x25, 0x60 };

IPAddress arduinoIp(192, 168, 250, 3);
IPAddress plcIp(192, 168, 250, 2);

const uint16_t FINS_PORT = 9600;

